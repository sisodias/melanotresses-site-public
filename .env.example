# Server-only provider configuration. Add these in Vercel Project Settings,
# never in VITE_* variables or browser code.

# Recommended: enables live website chat. The app still works with its
# grounded curated fallback when this is not set.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional alternate chat providers. The server checks Groq, xAI, then OpenAI.
# XAI_API_KEY=
# XAI_MODEL=grok-4.5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional: only for the /book?acuity-api server proxy. The ordinary Acuity
# embed used by /book does not require these values.
# ACUITY_USER_ID=
# ACUITY_API_KEY=

# Cloudflare-only native booking configuration. Vercel cannot expose a D1
# binding through environment variables; /book?native falls back to Acuity
# unless a separate Vercel database adapter is implemented.
# BOOKING_PAYMENT_MODE=deposit
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# BOOKING_FROM=
# BOOKING_TO=
# BOOKING_ADMIN_TOKEN=
